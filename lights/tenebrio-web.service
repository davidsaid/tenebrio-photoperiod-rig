[Unit]
Description=Tenebrio rig monitoring page (http://10.42.0.1 on the hotspot)
After=local-fs.target

[Service]
User=pi
WorkingDirectory=/opt/tenebrio-lights
ExecStart=/usr/bin/python3 /opt/tenebrio-lights/tenebrio_web.py --config /var/lib/tenebrio-lights/config.yaml --events /var/lib/tenebrio-lights/events.csv --readings /var/lib/tenebrio-lights/readings.csv --port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
StateDirectory=tenebrio-lights
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
